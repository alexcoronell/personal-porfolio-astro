{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["./components/*"],
      "@interfaces/*": ["./core/interfaces/*"],
      "@data/*": ["./core/data/*"],
      "@models/*": ["./core/models/*"],
      "@types/*": ["./core/types/*"],
      "@utils/*": ["./core/utils/*"],
      "@stores/*": ["./stores/*"],
    }
  }
}