{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "@components/*": ["./components/*"],
      "@i18n/*": ["./i18n/*"],
      "@interfaces/*": ["./core/interfaces/*"],
      "@data/*": ["./core/data/*"],
      "@models/*": ["./core/models/*"],
      "@types/*": ["./core/types/*"],
      "@shared/*": ["./components/shared/*"],
      "@stores/*": ["./stores/*"],
      "@utils/*": ["./core/utils/*"]
    }
  }
}
