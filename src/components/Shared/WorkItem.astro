---
/* Utils */
import { getLangFromUrl } from '../../i18n/utils';
import { translateStatusWork } from '../../i18n/translate';

/* Data */
import { type Work, type Status } from '../../core/types/PersonalData';

/* Props */
interface Props {
  item: Work;
  index: number;
}

const { item, index } = Astro.props;
const translateClass =
  index % 2 === 0 ? 'lg:translate-x-[-50%]' : 'lg:translate-x-[50%]';
let technologiesTitle = 'Technologies';
let status: Status | string = item.status;
let visitTextButton = 'Visit';
let visitTheCodeTextButton = 'Visit the code';
const lang = getLangFromUrl(Astro.url);
if (lang === 'es') {
  technologiesTitle = 'Tecnologías';
  status = translateStatusWork(item.status, lang);
  visitTextButton = 'Visita';
  visitTheCodeTextButton = 'Ve al código';
}

const pathImages = '/assets/images/briefcase/';
const hrefActive = item.url.length > 0;
---

<div class={`WorkItem ${translateClass}`}>
  <img
    class="rounded-t-lg"
    src={pathImages + item.image}
    alt={item.title + ' image'}
  />
  <div class="WorkItem__detail">
    <h5 class="WorkItem__title">
      {item.title}
    </h5>
    <p class="WorkItem__status">Status: {status}</p>
    <p class="WorkItem__technologiesTitle">{technologiesTitle}:</p>
    <div class="WorkItem__technologiesItems">
      {
        item.technologies.map(tech => {
          return (
            <span class="mb-3 mr-2 grow-0 rounded-full border border-primary px-2 text-[0.8rem] text-primary">
              {tech}
            </span>
          );
        })
      }
    </div>
  </div>
  <div class="flex w-full items-center justify-center gap-x-3">
    {
      hrefActive && (
        <a
          href={item.url}
          target="_blank"
          class="btn-primary inline-flex w-[130px] items-center justify-center text-center">
          {visitTextButton}
          <span class="sr-only">Visit the {item.title} website</span>
        </a>
      )
    }

    {
      !hrefActive && (
        <button
          class="btn-primary btn-primary--disabled inline-flex w-[130px] items-center justify-center text-center"
          role="button"
          aria-disabled="true"
          disabled
          title={`The ${item.title} website is not available at this time`}>
          {visitTextButton}
          <span class="sr-only">
            The {item.title} website is not available at this time
          </span>
        </button>
      )
    }

    {
      item.publicCode && (
        <a
          href={item.codeUrl}
          target="_blank"
          class="btn-primary inline-flex w-[130px] items-center justify-center px-4 text-center">
          {visitTheCodeTextButton}
          <span class="sr-only">Visit the {item.title} code</span>
        </a>
      )
    }
    {
      !item.publicCode && (
        <button
          class="btn-primary btn-primary--disabled inline-flex w-[130px] items-center justify-center text-center"
          role="button"
          aria-disabled="true"
          disabled
          title={`The ${item.title} code is private`}>
          {visitTheCodeTextButton}
          <span class="sr-only">The {item.title} code is private</span>
        </button>
      )
    }
  </div>
</div>

<style>
  .WorkItem {
    @apply mx-auto mb-5 flex max-w-sm translate-y-[25%] flex-col justify-between overflow-hidden rounded-lg border border-primary/30 p-0 pb-5 opacity-0 shadow md:m-0;
    animation: animationFadeInTranslate linear forwards;
    animation-timeline: view();
    animation-range-start: 10%;
    animation-range-end: 30%;

    &__detail {
      @apply flex grow flex-col p-5;
    }

    &__title {
      @apply mb-0 text-lg font-bold tracking-tight;
    }

    &__status {
      @apply mb-3 mt-0;
      font-style: italic;
    }

    &__technologiesItems {
      @apply flex w-full flex-wrap overflow-hidden text-wrap;
    }
  }
</style>
