export const ENGLISH_SEO_KEYWORDS: string[] = [
  'Frontend Developer',
  'Fullstack Developer',
  'Software Engineer',
  'Web Development',
  'UI Design',
  'UX Experience',
  'Web Application Development',
  'Developer Portfolio',
  'Alex Coronell',
  'Angular',
  'AstroJS',
  'React.js',
  'React',
  'Next.js',
  'TypeScript',
  'JavaScript',
  'HTML',
  'CSS',
  'Node.js',
  'NestJS',
  'RESTful APIs',
  'Git',
  'GitHub',
  'Tailwind',
  'Bootstrap',
  'Dynamic User Interfaces',
  'Robust Web Applications',
  'Responsive Design',
  'Web Performance',
  'Clean Code',
