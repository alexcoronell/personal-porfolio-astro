---
import HeadSeo from './HeadSeo.astro';

interface Props {
  title: string;
  location: string;
}

import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const enDescription =
  'Fullstack & Frontend Developer expert in building robust web applications and dynamic user interfaces. Explore my portfolio and projects.';
const esDescription =
  'Desarrollador Fullstack & Frontend experto en la creación de aplicaciones web robustas e interfaces de usuario dinámicas. Explora mi portafolio y proyectos.';

const metadescription = lang === 'es' ? esDescription : enDescription;
const locale = lang === 'es' ? 'es_CO' : 'en_US';

const { title, location } = Astro.props;

import { personalData } from '../../core/data/personalData';
---

<head>
  <!-- Google tag (gtag.js) -->
  <script
    is:inline
    async
    src="https://www.googletagmanager.com/gtag/js?id=G-ERK96N0KGF"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());

    gtag('config', 'G-ERK96N0KGF');
  </script>

  <!-- Bing HTML Meta Tag -->
  <meta name="msvalidate.01" content="9F9D2A61BF1C263D384A41045D5126A4" />

  <meta name="locale" content={locale} />
  <meta charset="utf-8" />
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="site_name" content={personalData.site} />
  <meta name="author" content={personalData.shortname} />
  <meta name="url" content={location} />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/ico" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="robots" content="index, follow" />
  <HeadSeo
    title={title}
    metaDescription={metadescription}
    noindex={false}
    nofollow={false}
  />
</head>
