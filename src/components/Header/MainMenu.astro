---
/* Components */
import MenuIcon from '../UI/icons/MenuIcon.astro';
import CloseIcon from '../UI/icons/CloseIcon.astro';
import SpainFlagIcon from '../UI/icons/SpainFlagIcon.astro';
import UsaFlagIcon from '../UI/icons/UsaFlagIcon.astro';

/* Utils */
import { getLangFromUrl } from '../../i18n/utils';
import { translateMenu } from '../../i18n/translate';

/* Models */
import type { MenuItem } from '../../core/models/MenuItem.interface';

const lang = getLangFromUrl(Astro.url);

const menuItems: MenuItem[] = translateMenu(lang);

let resumeName = '';
let resumeUrl = '';

if (lang === 'es') {
  resumeName = 'Hoja de Vida';
  resumeUrl = '/assets/resume/Hoja-de-Vida.pdf';
} else {
  resumeName = 'Resume';
  resumeUrl = '/assets/resume/CV-Resume.pdf';
}
---

<div class='MainMenu p-3'>
  <button
    type='button'
    id='open-menu-button'
    class='xl:hidden'
    role='button'
    aria-label='Open the menu'
    ><MenuIcon class='size-10' /><span class='sr-only'>Open the menu</span
    ></button
  >
  <div class='blurFilter filter hiddenFilter' id='filter'></div>
  <nav id='menu' class='menu hidden-menu'>
    <div class='areaCloseMenuButton'>
      <button
        type='button'
        id='close-menu-button'
        role='button'
        aria-label='Close the menu'
        ><CloseIcon class='size-10' />
        <span class='sr-only'>Close the menu</span>
      </button>
    </div>
    <div class='menuItems'>
      {
        menuItems.map((item, index) => (
          <a
            class='MainMenuItem'
            href={'#' + item.url}
            data-scroll-to={item.url}
            aria-label={`Go to ${item.name} section`}
          >
            <span class='index'>0{index + 1}.</span>
            <span class='name transitionAc'>{item.name}</span>
            <span class='sr-only'>Go to {item.name} section</span>
          </a>
        ))
      }
      <a
        href={resumeUrl}
        target='_blank'
        class='navResumeButton btn-primary'
        download={`${resumeName}.pdf`}
        aria-label={`Download my ${resumeName}`}
        >{resumeName}
        <span class='sr-only'>Download my {resumeName}</span>
      </a>
      <div class='languageMenu'>
        <a
          href='es'
          id='spainFlagIcon'
          arial-label='Cambia el lenguaje a español'
          ><SpainFlagIcon /><span class='sr-only'
            >Cambia el lenguaje a español</span
          ></a
        >
        <a href='/' id='usaFlagIcon' arial-label='Change language to English'
          ><UsaFlagIcon /><span class='sr-only'>Change language to English</span
          ></a
        >
      </div>
    </div>
  </nav>
</div>

<script is:inline>
  const openMenuButton = document.getElementById('open-menu-button');
  const closeMenuButton = document.getElementById('close-menu-button');
  const spainFlagIcon = document.getElementById('spainFlagIcon');
  const usaFlagIcon = document.getElementById('usaFlagIcon');
  const menu = document.getElementById('menu');
  const filter = document.getElementById('filter');
  const mainMenuItem = document.querySelectorAll('.MainMenuItem');
  let hiddenMenu = true;
  const pathName = window.location.pathname.replace('/', '');
  const lang = pathName === 'es' ? 'es' : 'en';
  const smoothScrollLinks = document.querySelectorAll('a[data-scroll-to]');
  
  openMenuButton?.addEventListener('click', () => toggleMenu(false));

  closeMenuButton?.addEventListener('click', () => toggleMenu(true));

  mainMenuItem.forEach((element) => {
    element?.addEventListener('click', () => toggleMenu(true));
  });

  toggleMenu = (toggle) => {
    hiddenMenu = toggle;
    if (hiddenMenu) {
      menu?.classList.add('hidden-menu');
      filter?.classList.add('hiddenFilter');
      filter?.classList.remove('showFilter');
    } else {
      menu?.classList.remove('hidden-menu');
      filter?.classList.remove('hiddenFilter');
      filter?.classList.add('showFilter');
    }
  };

  changeLanguageIcons = () => {
    if (lang === 'es') {
      spainFlagIcon.style.display = 'none';
      usaFlagIcon.style.display = 'block';
    } else {
      spainFlagIcon.style.display = 'block';
      usaFlagIcon.style.display = 'none';
    }
  };

  smoothScrollLinks.forEach((link) => {
    link.addEventListener('click', function (event) {
      const width = window.innerWidth()
      if(width < 1200) return;

      event.preventDefault();

      const targetId = this.getAttribute('data-scroll-to');
      const targetElement = document.getElementById(targetId);

      if (targetElement) {
        targetElement.scrollIntoView({
          behavior: 'smooth',
          block: 'start',
        });
      }
    });
  });

  changeLanguageIcons();
</script>

<style>
  .MainMenu {
    @apply w-full max-xl:text-right xl:w-auto;
    nav.menu {
      @apply fixed h-screen
            right-0 top-0 bottom-0 
            bg-primary-dark/90 
            flex flex-col w-[80%]
            max-xl:max-h-screen
            transition-all duration-500
            xl:static xl:w-full xl:h-auto;
      .areaCloseMenuButton {
        @apply w-full py-4 px-5 text-right grow-0 xl:hidden;
      }
      .menuItems {
        @apply flex flex-col items-center justify-center h-full gap-y-5 grow pb-8
              xl:flex-row xl:items-center gap-x-5 xl:pb-0 text-sm;
      }
    }
  }

  nav.menu.hidden-menu {
    right: -100% !important;
  }

  .navResumeButton {
    @apply px-12 py-3 mt-5 xl:mt-0 xl:px-4 xl:py-2;
  }
  #filter {
    @apply fixed h-screen top-0 right-0 bottom-0 border transition delay-300;
  }

  .hiddenFilter {
    @apply opacity-0 w-0;
  }

  .showFilter {
    @apply w-full;
  }

  .MainMenuItem {
    @apply flex flex-col items-center justify-center xl:flex-row gap-x-2 mx-3 xl:text-sm 3xl:text-lg;

    .index {
      font-family: 'Fira Mono', sans-serif;
    }
    .name {
      font-family: 'Orbitron Variable', sans-serif;
      @apply text-white/70 hover:text-primary;
    }
  }
  .languageMenu {
    @apply flex gap-x-3;
  }
</style>
