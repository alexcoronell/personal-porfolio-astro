---
/* Utils */
import { getLangFromUrl } from '../i18n/utils';

/* Data */
import { personalData } from '../core/data/personal-data.ts';

const lang = getLangFromUrl(Astro.url);

let text = '';

if (lang === 'es') {
  text = 'Desarrollado por';
} else {
  text = 'Built by';
}
---

<footer class="Footer">
  <h6>{text} {personalData.shortname}</h6>
</footer>

<style>
  footer.Footer {
    @apply w-full pb-8 pt-5 text-center md:pb-7 md:pt-8 lg:pb-9 lg:pt-10 xl:pb-7;
  }
</style>
