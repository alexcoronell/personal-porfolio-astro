---
/* Components */
import Section from '@shared/Section.astro';

/* Data */
import { personalData } from '@data/personal-data';

/* Types */
import { type MenuItem } from '@interfaces/menu-item.interface';

/* Utils */
import { getLangFromUrl, useTranslations } from '@i18n/index';
import { translateMenu } from '@i18n/translate';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const menuItems: MenuItem[] = translateMenu(lang);
const profileImgMobile = 'assets/images/profile/alex-coronell-mobile.webp';
const profileImgDesktop = 'assets/images/profile/alex-coronell-desktop.webp';
const index = 1;
const title = menuItems[index - 1].name;
const idTag = menuItems[index - 1].url;

import './_About.scss';
---

<Section index={index} title={title} idTag={idTag}>
  <div class="AboutMe">
    <div class="AboutMe__pictureBox">
      <picture class="AboutMe__pictureBox__picture">
        <img
          class="mobile"
          src={profileImgMobile}
          alt={personalData.shortname + ' Profile Image'}
        />
        <img
          class="desktop"
          src={profileImgDesktop}
          alt={personalData.shortname + ' Profile Image'}
        />
      </picture>
    </div>
    <div class="AboutMe__text">
      <h5>{t('presentation.titleLongPresentation')}</h5>
      {t('presentation.longPresentation').map(p => <p>{p}</p>)}
    </div>
  </div>
</Section>

<style lang="scss">
  .AboutMe {
    &__pictureBox,
    &__text {
      @apply opacity-0;
    }
    &__pictureBox {
      @apply max-lg:scale-50 lg:translate-x-[-100%];
      animation: animationFadeInScale linear forwards;
      animation-timeline: view();
      animation-range-start: 20%;
      animation-range-end: 40%;
    }
    &__text {
      animation: animationFadeIn linear forwards;
      animation-timeline: view();
      animation-range-start: 15%;
      animation-range-end: 40%;
    }
  }

  @media screen and (min-width: 1024px) {
    .AboutMe {
      &__pictureBox {
        animation-name: animationFadeInTranslate;
      }
    }
  }
</style>
