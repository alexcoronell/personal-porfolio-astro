---
/* Components */
import Section from '@shared/Section.astro';
import JavaIcon from '../UI/icons/JavaIcon.astro';
import SpringIcon from '../UI/icons/SpringIcon.astro';
import NextjsIcon from '../UI/icons/NextjsIcon.astro';
import PythonIcon from '../UI/icons/PythonIcon.astro';
import CSharpIcon from '../UI/icons/CSharpIcon.astro';

/* Types */
import { type MenuItem } from '../../core/interfaces/menu-item.interface';

/* Utils */
import { getLangFromUrl } from '../../i18n/utils';
import { translateMenu } from '../../i18n/translate';

const lang = getLangFromUrl(Astro.url);
const menuItems: MenuItem[] = translateMenu(lang);

const index = 3;
const title = menuItems[index - 1].name;
const idTag = menuItems[index - 1].url;
---

<Section index={index} title={title} idTag={idTag}>
  <div class="learning" id="learning">
    <div class="learning__item learning__item1">
      <JavaIcon class="text-5xl lg:size-12 xl:size-14" /><span>Java</span>
    </div>
    <div class="learning__item learning__item2">
      <SpringIcon class="text-5xl lg:size-12 xl:size-14" /><span>Spring</span>
    </div>
    <div class="learning__item learning__item3">
      <NextjsIcon class="text-5xl lg:size-12 xl:size-14" /><span>NextJS</span>
    </div>
    <div class="learning__item learning__item4">
      <PythonIcon class="text-5xl lg:size-12 xl:size-14" /><span>Python</span>
    </div>
    <div class="learning__item learning__item5">
      <CSharpIcon class="text-5xl lg:size-12 xl:size-14" /><span>C#</span>
    </div>
  </div>
</Section>

<style>
  .learning {
    @apply relative my-8 h-[100px] w-full overflow-hidden;
    mask-image: linear-gradient(
      to right,
      rgba(0, 0, 0, 0),
      rgba(0, 0, 0, 1) 15%,
      rgba(0, 0, 0, 1) 85%,
      rgba(0, 0, 0, 0)
    );

    &__item {
      @apply absolute flex h-[100px] w-[200px] items-center justify-center gap-x-5 bg-transparent px-8;
      left: calc(200px * 5);
      animation-name: scrollLeft;
      animation-duration: 15s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;

      span {
        @apply m-0 md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem];
      }
    }

    &__item1 {
      animation-delay: calc(15s / 5 * (5 - 1) * -1);
    }

    &__item2 {
      animation-delay: calc(15s / 5 * (5 - 2) * -1);
    }

    &__item3 {
      animation-delay: calc(15s / 5 * (5 - 3) * -1);
    }

    &__item4 {
      animation-delay: calc(15s / 5 * (5 - 4) * -1);
    }

    &__item5 {
      animation-delay: calc(15s / 5 * (5 - 5) * -1);
    }

    @keyframes scrollLeft {
      to {
        left: -300px;
      }
    }
  }
</style>
