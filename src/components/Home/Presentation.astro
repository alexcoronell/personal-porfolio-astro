---
/* Types */
import type { MenuItem } from '../../core/models/MenuItem.interface';

/* Utils */
import { getLangFromUrl } from '../../i18n/utils';
import { translateMenu } from '../../i18n/translate';

/* Data */
import { personalData } from '../../core/data/personalData';

const lang = getLangFromUrl(Astro.url);
const menu: MenuItem[] = translateMenu(lang);
const worksId = menu[3].url;

let title = 'Hi, my name is';
let text = 'Know my works';
let shortPresentation =
  '20+ years in IT | 5+ Years Fullstack & Frontend Development Expert. I specialize in creating robust web applications and dynamic user interfaces with Angular, React, and Astro.js. Explore my portfolio to see how I can bring your next project to life.';

if (lang === 'es') {
  title = 'Hola, mi nombre es';
  text = 'Conoce mi trabajo';
  shortPresentation =
    'Más de 20 años en TI | 5+ años Experto en Desarrollo Fullstack y Frontend. Soy experto en crear aplicaciones web robustas y interfaces de usuario dinámicas con Angular, React y Astro.js. Descubre mi portafolio para ver cómo puedo materializar tu próximo proyecto.';
}
---

<div class='Presentation'>
  <div class='Presentation__content'>
    <h5>{title}</h5>
    <h1>{personalData.shortname}.</h1>
    <p>{shortPresentation}</p>
    <a href={'#' + worksId} id='know-my-works-btn' class='btn-primary'
      >{text}!</a
    >
  </div>
</div>

<script is:inline>
  const knowMyWorksBtn = document.getElementById('know-my-works-btn');
  knowMyWorksBtn.addEventListener('click', (e) => {
    const width = window.innerWidth;
    if (width < 1200) return;
    e.preventDefault();
    const targetElement = document.getElementById('Works');
    console.log(targetId);
    console.log(targetElement);
    if (targetElement) {
      targetElement.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    }
  });
</script>

<style>
  .Presentation {
    @apply w-full max-w-[100vw] overflow-x-hidden h-screen flex flex-col justify-center items-center;
    &__content {
      @apply px-6 sm:px-12 lg:px-0 w-full md:max-w-[700px] xl:max-w-[900px];

      h5,
      h1,
      p,
      a {
        animation-fill-mode: forwards;
        animation-iteration-count: 1;
        animation-timing-function: linear;
      }

      h5 {
        @apply mb-2 lg:mb-4 opacity-0;
        animation: animationFadeIn;
        animation-delay: 0.3s;
        animation-duration: 0.3s;
        animation-fill-mode: forwards;
      }
      h1 {
        @apply text-white mb-14 xl:max-w-[500px] opacity-0 translate-x-[100%];
        animation: animationFadeInTranslate;
        animation-delay: 0.7s;
        animation-duration: 1s;
        animation-fill-mode: forwards;
      }
      p {
        @apply mb-14 text-balance text-xl lg:text-2xl opacity-0 translate-y-[50%];
        animation: animationFadeInTranslate;
        animation-delay: 1.4s;
        animation-duration: 0.5s;
        animation-fill-mode: forwards;
      }
      a {
        @apply w-[180px] my-5 opacity-0;
        animation: animationFadeIn;
        animation-delay: 2s;
        animation-duration: 0.5s;
        animation-fill-mode: forwards;
      }
    }
  }
</style>
