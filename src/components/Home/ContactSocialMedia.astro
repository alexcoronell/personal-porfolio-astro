---
import { personalData } from '../../core/data/personal-data';
---

<div class="ContactSocialMedia">
  <ul>
    <li>
      <a
        href={personalData.linkedin}
        target="_blank"
        class="linkedinLink"
        rel="noopener noreferrer">
        <span class="icon-[bxl--linkedin]"></span>
        <span class="sr-only">Visit the {personalData.shortname} Linkedin</span>
        <p>{personalData.linkedin}</p>
      </a>
    </li>
    <li>
      <a
        href={personalData.github}
        target="_blank"
        class="githubLink"
        rel="noopener noreferrer">
        <span class="icon-[bxl--github]"></span>
        <span class="sr-only">Visit the {personalData.shortname} Github</span>
        <p>{personalData.github}</p>
      </a>
    </li>
    <li>
      <a
        href={personalData.gitlab}
        target="_blank"
        class="gitlabLink"
        rel="noopener noreferrer">
        <span class="icon-[bxl--gitlab]"></span>
        <span class="sr-only">Visit the {personalData.shortname} Gitlab</span>
        <p>{personalData.gitlab}</p>
      </a>
    </li>
    <li>
      <a
        href={'https://wa.me/' + personalData.whatsappClean2}
        target="_blank"
        class="whatsappLink"
        rel="noopener noreferrer">
        <span class="icon-[bxl--whatsapp]"></span>
        <span class="sr-only"
          >Write to {personalData.shortname} on WhatsApp</span
        >
        <p>{personalData.whatsapp2}</p>
      </a>
    </li>
    <li>
      <a
        href={'mailto:' + personalData.email3}
        target="_blank"
        class="gmailLink"
        rel="noopener noreferrer">
        <span class="icon-[material-symbols--alternate-email-rounded]"></span>
        <span class="sr-only">Write an email to {personalData.shortname}</span>
        <p>{personalData.email3}</p>
      </a>
    </li>
  </ul>
</div>

<style>
  .ContactSocialMedia {
    @apply pb-5 pt-20 md:translate-y-[25%] md:opacity-0 lg:py-0;
    ul {
      @apply m-0 flex items-center justify-center gap-x-5 p-0 lg:h-full lg:flex-col lg:items-start lg:justify-center lg:gap-x-0 lg:gap-y-10;
      li {
        @apply my-0;
        a {
          @apply relative flex h-[45px] w-[45px] cursor-pointer items-center justify-center rounded-full bg-gray-dark text-center text-gray transition-all duration-500 lg:h-[70px] lg:w-[70px];
          span {
            @apply m-0 p-0 text-[25px] lg:text-[40px];
          }
          p {
            font-family: 'Fira Mono', sans-serif;
            @apply absolute left-[95px] text-sm transition-all duration-500 max-lg:hidden lg:whitespace-nowrap;
          }
          &::before {
            content: '';
            @apply absolute left-0 top-0 z-[-1] h-full w-full scale-90 rounded-full bg-primary transition-all duration-500;
          }
          &:hover::before {
            box-shadow: 0 0 15px;
          }
          &:hover {
            box-shadow: 0 0 5px;
          }
          &.linkedinLink {
            @apply hover:text-linkedin hover:shadow-linkedin;
            &::before {
              @apply hover:shadow-linkedin;
            }
            &:hover {
              p {
                @apply text-linkedin;
              }
            }
          }
          &.githubLink {
            @apply hover:text-github hover:shadow-github;
            &::before {
              @apply hover:shadow-github;
            }
            &:hover {
              p {
                @apply text-github;
              }
            }
          }
          &.gitlabLink {
            @apply hover:text-gitlab hover:shadow-gitlab;
            &::before {
              @apply hover:shadow-gitlab;
            }
            &:hover {
              p {
                @apply text-gitlab;
              }
            }
          }
          &.whatsappLink {
            @apply hover:text-whatsapp hover:shadow-whatsapp;
            &::before {
              @apply hover:shadow-whatsapp;
            }
            &:hover {
              p {
                @apply text-whatsapp;
              }
            }
          }
          &.gmailLink {
            @apply hover:text-primary hover:shadow-primary;
            &::before {
              @apply hover:shadow-primary;
            }
            &:hover {
              p {
                @apply text-primary;
              }
            }
          }
        }
      }
    }
  }
  @media (min-width: 768px) {
    .ContactSocialMedia {
      animation: animationFadeInTranslate linear forwards;
      animation-timeline: view();
      animation-range-start: 10%;
      animation-range-end: 35%;
    }
  }
</style>
