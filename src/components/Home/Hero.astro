---
/* Types */
import type { MenuItem } from '@interfaces/menu-item.interface';

/* Utils */
import { getLangFromUrl, useTranslations } from '@i18n/index';
import { translateMenu } from '@i18n/translate';

/* Data */
import { personalData } from '@data/personal-data';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const menu: MenuItem[] = translateMenu(lang);
const worksId = menu[3].url;
---

<div class="Presentation">
  <div class="Presentation__content">
    <h5>{t('presentation.greeting')}</h5>
    <h1>{personalData.shortname}.</h1>
    <p>{t('presentation.shortPresentation')}</p>
    <a href={'#' + worksId} id="know-my-works-btn" class="btn-primary"
      >{t('presentation.buttonText')}!</a
    >
  </div>
</div>

<script is:inline>
  const knowMyWorksBtn = document.getElementById('know-my-works-btn');
  knowMyWorksBtn.addEventListener('click', e => {
    const width = window.innerWidth;
    if (width < 1200) return;
    e.preventDefault();
    const targetElement = document.getElementById('Works');
    console.log(targetId);
    console.log(targetElement);
    if (targetElement) {
      targetElement.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    }
  });
</script>

<style>
  .Presentation {
    @apply flex h-screen w-full max-w-[100vw] flex-col items-center justify-center overflow-x-hidden;
    &__content {
      @apply w-full px-6 sm:px-12 md:max-w-[700px] lg:px-0 xl:max-w-[900px];

      h5,
      h1,
      p,
      a {
        animation-fill-mode: forwards;
        animation-iteration-count: 1;
        animation-timing-function: linear;
      }

      h5 {
        @apply mb-2 opacity-0 lg:mb-4;
        animation: animationFadeIn;
        animation-delay: 0.3s;
        animation-duration: 0.3s;
        animation-fill-mode: forwards;
      }
      h1 {
        @apply mb-14 translate-x-[100%] text-white opacity-0 xl:max-w-[500px];
        animation: animationFadeInTranslate;
        animation-delay: 0.7s;
        animation-duration: 1s;
        animation-fill-mode: forwards;
      }
      p {
        @apply mb-14 translate-y-[50%] text-balance text-xl opacity-0 lg:text-2xl;
        animation: animationFadeInTranslate;
        animation-delay: 1.4s;
        animation-duration: 0.5s;
        animation-fill-mode: forwards;
      }
      a {
        @apply my-5 w-[180px] opacity-0;
        animation: animationFadeIn;
        animation-delay: 2s;
        animation-duration: 0.5s;
        animation-fill-mode: forwards;
      }
    }
  }
</style>
