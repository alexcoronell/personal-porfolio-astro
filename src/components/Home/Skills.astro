---
/* Components */
import Section from '../Shared/Section.astro';
import HtmlIcon from '../UI/icons/HtmlIcon.astro';
import CssIcon from '../UI/icons/CssIcon.astro';
import JavascriptIcon from '../UI/icons/JavascriptIcon.astro';
import GitIcon from '../UI/icons/GitIcon.astro';
import TypescriptIcon from '../UI/icons/TypescriptIcon.astro';
import AngularIcon from '../UI/icons/AngularIcon.astro';
import ReactIcon from '../UI/icons/ReactIcon.astro';
import AstroIcon from '../UI/icons/AstroIcon.astro';
import SvelteIcon from '../UI/icons/SvelteIcon.astro';
import LinuxIcon from '../UI/icons/LinuxIcon.astro';
import NestJsIcon from '../UI/icons/NestJsIcon.astro';
import NodeJsIcon from '../UI/icons/NodeJsIcon.astro';
import BootstrapIcon from '../UI/icons/BootstrapIcon.astro';
import SassIcon from '../UI/icons/SassIcon.astro';
import TailwindCssIcon from '../UI/icons/TailwindCssIcon.astro';

/* Types */
import { type MenuItem } from '../../core/models/MenuItem.interface';

/* Utils */
import { getLangFromUrl } from '../../i18n/utils';
import { translateMenu } from '../../i18n/translate';

const lang = getLangFromUrl(Astro.url);
const menuItems: MenuItem[] = translateMenu(lang);

const index = 2;
const title = menuItems[index - 1].name;
const idTag = menuItems[index - 1].url;
---

<Section index={index} title={title} idTag={idTag}>
  <div class="Skills" id="Skills">
    <div
      class="bg-gray-800 relative mx-auto h-[180px] max-w-[301px] rounded-t-xl border-[8px] border-primary sm:h-[252px] sm:max-w-[419px] md:h-[294px] md:max-w-[512px] lg:h-[345px] lg:max-w-[600px] xl:h-[394px] xl:max-w-[686px]">
      <div
        class="laptopScreen grid grid-cols-3 items-center justify-center gap-y-2 overflow-hidden rounded-lg bg-background-icons p-1 md:gap-y-3 md:p-3 lg:p-4 xl:gap-y-4 xl:p-5">
        <article class="flex items-center justify-start gap-x-2">
          <HtmlIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]">
            HTML</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <CssIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >CSS</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <JavascriptIcon
            class="size-6 sm:size-10 lg:size-12 xl:size-14"
          /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >Javascript</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <AngularIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >Angular</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <ReactIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >React</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <SvelteIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >Svelte</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <AstroIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >Astro</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <TypescriptIcon
            class="size-6 sm:size-10 lg:size-12 xl:size-14"
          /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >Typescript</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <GitIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >GIT</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <LinuxIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >Linux</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <NestJsIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >NestJS</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <NodeJsIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >NodeJS</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <TailwindCssIcon
            class="size-6 sm:size-10 lg:size-12 xl:size-14"
          /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >Tailwind</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <BootstrapIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >Bootstrap</span
          >
        </article>
        <article class="flex items-center justify-start gap-x-2">
          <SassIcon class="size-6 sm:size-10 lg:size-12 xl:size-14" /><span
            class="text-[0.6rem] sm:text-[0.8rem] md:text-[1rem] lg:text-[1.1rem] xl:text-[1.2rem]"
            >Sass</span
          >
        </article>
      </div>
    </div>
  </div>

  <div
    class="dark:bg-gray-700 relative mx-auto h-[17px] max-w-[360px] rounded-b-xl rounded-t-sm bg-primary/70 sm:h-[24px] sm:max-w-[500px] md:h-[29px] md:max-w-[597px] lg:h-[34px] lg:max-w-[700px] xl:h-[39px] xl:max-w-[800px]">
    <div
      class="sm:h[7] absolute left-1/2 top-0 h-[5px] w-[56px] -translate-x-1/2 rounded-b-xl bg-primary sm:w-[78px] md:h-[8px] md:w-[96px] lg:h-[9px] lg:w-[113px] xl:h-[10px] xl:w-[129px]">
    </div>
  </div>
</Section>

<style>
  .laptopScreen {
    @apply opacity-0;
    animation: animationFadeIn 0.5s ease-in-out forwards;
    animation-timeline: view();
    animation-range-start: 20%;
    animation-range-end: 50%;
  }
</style>

