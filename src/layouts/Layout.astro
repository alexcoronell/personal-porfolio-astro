---
import Basehead from "../components/Shared/Basehead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ExperiencesDetailsModal from "../components/Home/ExperiencesDetailsModal.svelte";
import RequestModal from "../components/Home/RequestModal.svelte";
import "@fontsource/fira-mono";
import "@fontsource/rajdhani";
// Supports weights 100-900
import "@fontsource-variable/outfit";

import "../styles/main.scss";

interface Props {
  title: string;
  location: string;
}

const { title, location } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <Basehead title={title} location={location} />
  <body>
    <Header />
    <slot />
    <Footer />
    <ExperiencesDetailsModal client:load />
    <RequestModal client:load />
  </body>
</html>

<style is:global>
  html {
    body {
      @apply bg-primary-dark min-h-screen w-full;
    }
  }

  /* Specials */
  .transitionAc {
    @apply transition-all duration-500;
  }
  .blurFilter {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(6px);
  }

  /************************** Buttons **************************/
  .btn-primary, .btn-error {
    @apply border px-5 py-3 text-center lg:m-auto transition-all duration-300 hover:shadow-lg;
  }

  .btn-primary {
    @apply border-primary hover:bg-primary hover:text-primary-dark hover:shadow-primary/40 ;
  }

  .btn-error {
    @apply border-red hover:bg-red text-white;
  }

  .btn-primary--disabled {
    @apply cursor-not-allowed opacity-40
    hover:bg-transparent hover:text-primary hover:shadow-none;
  }

</style>
